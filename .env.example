# Скопируйте этот файл в .env и поправьте под себя.
# Сам .env в репозиторий не попадает (см. .gitignore) — он для секретов
# и настроек конкретного компьютера.

# Пароль администратора — ХЭШЕМ, а не открытым текстом: к файлу на сервере
# в мастерской есть доступ у тех, кто за ним сидит. Задаётся командой
#     python -m scripts.set_password
# она спросит пароль и впишет строку ниже сама. Администратор имеет все права
# и заходит с любого компьютера; без пароля сервер пускает по слову «admin»
# и предупреждает об этом при старте.
POSTER_ADMIN_PASSWORD_HASH=
# Старый способ, открытым текстом, всё ещё работает — но не надо:
# POSTER_ADMIN_PASSWORD=

# Ключ подписи сессий. Если не задать, будет сгенерирован в файл .secret
# при первом запуске. Менять не нужно; при смене все разлогинятся.
# POSTER_SECRET_KEY=

# Кто может обращаться к API из браузера (заголовок Origin). Интерфейс,
# открытый с этого же сервера, работает всегда — список нужен, только если
# страницу открывают с другого адреса. По умолчанию разрешены localhost:8000
# и localhost:5173 (режим разработки). Несколько адресов — через запятую.
# POSTER_ALLOWED_ORIGINS=http://192.168.1.10:8000,http://poster.local

# Реквизиты мастерской — печатаются в шапке квитанции клиенту.
# Это запасной вариант: то, что сохранено в разделе «Настройки» интерфейса,
# главнее этих строк. Ничего не задано — квитанция напечатается без шапки.
POSTER_SHOP_NAME=ПОСТЕР
POSTER_SHOP_PHONE=
POSTER_SHOP_ADDRESS=
# строка под адресом: часы работы, сайт — что нужнее
POSTER_SHOP_NOTE=

# Куда платить — кнопка «Оплата» в карточке заказа показывает это клиенту.
#
# Первые пять полей нужны для QR-кода по ГОСТ Р 56042: банковское приложение
# считает его камерой и подставит и реквизиты, и сумму заказа. Заполнены не
# все — QR не показывается, но карта и телефон ниже работают сами по себе.
POSTER_PAY_NAME=
# расчётный счёт, 20 цифр
POSTER_PAY_ACCOUNT=
POSTER_PAY_BANK=
# БИК, 9 цифр
POSTER_PAY_BIC=
# корреспондентский счёт банка, 20 цифр
POSTER_PAY_CORR_ACCOUNT=
# ИНН (10 или 12 цифр) и КПП (9) — банки часто требуют их в платеже
POSTER_PAY_INN=
POSTER_PAY_KPP=

# Показываем рядом с QR, без него не работает только QR:
POSTER_PAY_CARD=
POSTER_PAY_PHONE=
# строка под реквизитами: «Перевод по СБП», «В назначении укажите номер заказа»
POSTER_PAY_NOTE=

# Ссылка на перевод — второй способ, для перевода ФИЗЛИЦУ.
# Возьмите её в своём банке: «Перевести мне по ссылке», ссылка или наклейка
# СБП, «Мой QR» — называется у всех по-разному. Настоящий QR СБП умеет
# выпустить только банк, нарисовать его по номеру телефона нельзя.
#
# В ссылку подставляются два значения:
#   {phone}  — номер из POSTER_PAY_PHONE в виде 79881603218
#              (как бы он ни был записан выше — с плюсом, скобками, восьмёркой).
#              Нужен вид +7988… — пишите «+{phone}».
#   {amount} — сумма заказа в рублях, если банк принимает её в адресе.
#
# Сбербанк:
# POSTER_PAY_LINK=https://www.sberbank.ru/ru/choise_bank?requisiteNumber={phone}&bankCode=100000000111
POSTER_PAY_LINK=

# Что показывать: link — ссылка выше, gost — платёж по реквизитам.
# Пусто — решаем сами: есть ссылка, значит её.
POSTER_PAY_MODE=

# Кодировка платёжной строки: utf8 (по умолчанию) или win1251.
# Если приложение какого-то банка не читает наш QR — попробуйте win1251.
POSTER_PAY_ENCODING=utf8

# Почта — раздел «Почта»: читать письма, отвечать, уведомления о новых.
# Ящики подключаются в интерфейсе: «Настройки» → «Почта — ящики» (Яндекс,
# Mail.ru или любая почта с IMAP), там же кнопка «Проверить». Их может быть
# несколько; кому какой виден, задаётся в профиле сотрудника (не больше двух).
#
# Переменные ниже — только для первого запуска: если ящиков в системе ещё
# нет, а здесь ящик задан, он один раз переносится в список и дальше правится
# уже в интерфейсе. После переноса строки отсюда лучше убрать.
#
# Яндекс: включите IMAP (Почта → Настройки → Почтовые программы) и выпустите
# пароль приложения (id.yandex.ru → Безопасность → Пароли приложений → Почта).
# Mail.ru: Настройки → Безопасность → Пароли для внешних приложений, доступ
# «Полный доступ к почте (IMAP, POP, SMTP)»; серверы imap.mail.ru:993 и
# smtp.mail.ru:465. Обычный пароль от ящика ни там ни там не подойдёт.
POSTER_MAIL_USER=
POSTER_MAIL_PASSWORD=
# сервер:порт; по умолчанию Яндекс
POSTER_MAIL_IMAP=imap.yandex.ru:993
POSTER_MAIL_SMTP=smtp.yandex.ru:465
# как подписываются исходящие; пусто — название мастерской
POSTER_MAIL_SENDER=

# Папка для макетов заказов (файлы .cdr по номеру заказа).
# По умолчанию — designs/ рядом с проектом. На сервере укажите общую папку:
# POSTER_DESIGNS_DIR=D:/poster/designs

# По умолчанию используется локальный SQLite (poster.db рядом с проектом).
# Раскомментируйте и укажите свои данные, когда переедете на серверную БД:
# POSTER_DB_URL=postgresql+psycopg://user:pass@host:5432/poster

# ---------------------------------------------------------------------------
# Сервер в интернете (сотрудники на удалёнке). Подробно — README, «Удалённый доступ».
#
# POSTER_PUBLIC=1 включает строгий режим: сервер не стартует с паролем «admin»,
# без ключа подписи и без списка адресов; выключает /docs; отдаёт HSTS.
# POSTER_PUBLIC=
#
# На какие имена сервер отзывается (заголовок Host). Домен сервера; несколько —
# через запятую. Обязательно в режиме POSTER_PUBLIC.
# POSTER_ALLOWED_HOSTS=poster.example.ru
#
# Ежедневная копия базы силами самого сервера: время (местное для сервера)
# и сколько последних копий хранить. Пусто — копии по расписанию выключены.
# POSTER_BACKUP_AT=03:30
# POSTER_BACKUP_KEEP=30
# Куда складывать копии; по умолчанию backups/ рядом с проектом.
# POSTER_BACKUP_DIR=/app/data/backups

# Логи. Пишутся в logs/, файлы обрезаются сами (5 файлов по 5 МБ).

# DEBUG — всё подряд, WARNING — только проблемы
POSTER_LOG_LEVEL=INFO
POSTER_LOG_DIR=./logs
# 0 — не писать обычные запросы, только ошибки
POSTER_LOG_REQUESTS=1
# с какого времени запрос считается медленным
POSTER_SLOW_MS=800

# Настройки сервера — читает docker-compose.yml. Заполняет deploy/setup.sh.
# Настройки самой системы (пароль, ключ, почта, копии) — в poster-ocr/.env.

# Что запускать на этом сервере:
#   all   сайт и система (CRM) — оба здесь
#   crm   только система (сайт — на другом сервере, на Tilda или его нет)
#   site  только сайт (система — на другом сервере)
COMPOSE_PROFILES=all

# Домены — в punycode (так их понимают Caddy и Let's Encrypt); перевести:
#   python3 -c "print('постерпринт.рф'.encode('idna').decode())"
# Каждый домен должен указывать на этот сервер (A-запись в DNS).

# сайт-визитка (нужен в режимах all и site)
POSTER_DOMAIN=xn--e1agpbecgbfkg.xn--p1ai

# Зеркало Debian для сборки образа CRM. Из России deb.debian.org бывает в
# сотни раз медленнее — тогда: POSTER_DEBIAN_MIRROR=https://mirror.yandex.ru/debian
POSTER_DEBIAN_MIRROR=

# система — свой поддомен: в DNS добавьте A-запись «crm» на адрес сервера.
# Нужен в режимах all и crm; в режиме site — куда ведёт «Вход для сотрудников»
POSTER_CRM_DOMAIN=crm.xn--e1agpbecgbfkg.xn--p1ai

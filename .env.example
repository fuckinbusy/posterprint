# Настройки сервера в интернете — читает docker-compose.yml.
# Настройки самой системы (пароль, ключ, почта, копии) — в poster-ocr/.env.

# Домен, на который указывает DNS этого сервера. Его же Caddy использует для
# сертификата Let's Encrypt, а система — как единственное разрешённое имя.
POSTER_DOMAIN=example.ru

# Под каким путём живёт система; корень домена — сайт-визитка.
# Пусто — система в корне (тогда уберите визитку из deploy/Caddyfile).
POSTER_BASE_PATH=/poster-crm

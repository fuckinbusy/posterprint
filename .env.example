# Скопируйте этот файл в .env и поправьте под себя.
# Сам .env в репозиторий не попадает (см. .gitignore) — он для секретов
# и настроек конкретного компьютера.

# Пароль для входа в профиль администратора. ОБЯЗАТЕЛЬНО смените перед тем,
# как открывать доступ коллегам: администратор имеет все права всегда и
# заходит с любого компьютера.
# Если не задать, используется «admin» и при старте сервер об этом предупредит.
POSTER_ADMIN_PASSWORD=

# Ключ подписи сессий. Если не задать, будет сгенерирован в файл .secret
# при первом запуске. Менять не нужно; при смене все разлогинятся.
# POSTER_SECRET_KEY=

# Кто может обращаться к API из браузера (заголовок Origin). Интерфейс,
# открытый с этого же сервера, работает всегда — список нужен, только если
# страницу открывают с другого адреса. По умолчанию разрешены localhost:8000
# и localhost:5173 (режим разработки). Несколько адресов — через запятую.
# POSTER_ALLOWED_ORIGINS=http://192.168.1.10:8000,http://poster.local

# Папка для макетов заказов (файлы .cdr по номеру заказа).
# По умолчанию — designs/ рядом с проектом. На сервере укажите общую папку:
# POSTER_DESIGNS_DIR=D:/poster/designs

# По умолчанию используется локальный SQLite (poster.db рядом с проектом).
# Раскомментируйте и укажите свои данные, когда переедете на серверную БД:
# POSTER_DB_URL=postgresql+psycopg://user:pass@host:5432/poster

# Логи. Пишутся в logs/, файлы обрезаются сами (5 файлов по 5 МБ).

# DEBUG — всё подряд, WARNING — только проблемы
POSTER_LOG_LEVEL=INFO
POSTER_LOG_DIR=./logs
# 0 — не писать обычные запросы, только ошибки
POSTER_LOG_REQUESTS=1
# с какого времени запрос считается медленным
POSTER_SLOW_MS=800

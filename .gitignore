# Общий .gitignore монорепозитория: правила без косой черты в начале действуют
# в любой папке — и в poster-ocr, и в poster-website.

# Секреты и локальные настройки
.env
.secret

# Данные системы: база, бэкапы, макеты заказов, логи — здесь данные клиентов,
# в репозиторий им нельзя
poster.db
poster.db-wal
poster.db-shm
backups/
designs/
logs/
# кэши инструментов CRM: курсы ЦБ и скачанные шрифты — пересоздаются сами
cache/
fonts_cache/
# данные контейнеров (docker-compose.yml монтирует сюда базу, копии, макеты, логи)
data/

# Окружения и кэши
wheels/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
*.tsbuildinfo

# Локальные настройки инструментов
.claude/
.vscode/
.idea/

# Сборка сайта-визитки собирается в Docker, в репозиторий не идёт
poster-website/dist/

# Собранный интерфейс системы (poster-ocr/static/dist) НЕ игнорируется
# намеренно: сервер отдаёт именно его, и на рабочем компьютере Node.js может
# не быть вовсе. А вот карты исходников — по 2 МБ на сборку, для работы не нужны.
**/static/dist/**/*.map

# Сайт, запущенный ./poster.sh start site: pid и журнал процесса
poster-website/.site.pid
poster-website/site.log*
# снимок каталога Google Fonts — это код, а не данные пользователя
!poster-ocr/app/data/
!poster-ocr/app/data/google_fonts.json

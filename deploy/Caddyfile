# Caddy на сервере: один домен, сайт-визитка в корне, система под своим путём.
#
#   https://example.ru/               сайт-визитка — контейнер site (poster-website)
#   https://example.ru/poster-crm/    система — контейнер app (poster-ocr)
#
# https с сертификатом Let's Encrypt выпускается и продлевается сам: домен
# должен указывать на этот сервер, порты 80 и 443 — быть открыты.
#
# Переменные приходят из docker-compose.yml (POSTER_DOMAIN, POSTER_BASE_PATH).
# Без Docker впишите значения руками: домен вместо {$POSTER_DOMAIN}, путь
# вместо {$POSTER_BASE_PATH}, 127.0.0.1:8000 вместо app:8000, а блок визитки
# замените на «root * /путь/к/собранному/сайту» + «file_server».

{$POSTER_DOMAIN} {
	encode zstd gzip

	# ---- система: /poster-crm/… → приложение, префикс отрезается.
	# «/poster-crm» без косой черты — на «/poster-crm/», иначе относительные
	# адреса страницы ушли бы в корень домена, к визитке
	redir {$POSTER_BASE_PATH} {$POSTER_BASE_PATH}/ permanent

	handle_path {$POSTER_BASE_PATH}/* {
		# макеты .cdr бывают по сотне мегабайт — лимит выше, чем у самого приложения
		request_body {
			max_size 320MB
		}
		# X-Forwarded-For и X-Forwarded-Proto Caddy ставит сам; по ним приложение
		# считает лимит попыток входа, отмечает устройства и включает HSTS
		reverse_proxy app:8000 {
			# загрузка большого макета по медленному каналу
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	# ---- сайт-визитка: всё остальное. Свой Caddy внутри контейнера отдаёт
	# собранный React и знает про адреса без файлов (маршруты приложения)
	handle {
		reverse_proxy site:80
	}

	header {
		# приложение отдаёт свои заголовки безопасности; здесь только то,
		# что имеет смысл на уровне сервера
		-Server
	}

	log {
		output stderr
		format console
	}
}

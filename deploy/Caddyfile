# Caddy перед ПОСТЕРом: https с автоматическим сертификатом, сжатие,
# передача настоящего адреса клиента.
#
# Домен берётся из переменной POSTER_DOMAIN (docker-compose.yml). Без Docker
# впишите домен вместо {$POSTER_DOMAIN} и адрес 127.0.0.1:8000 вместо app:8000.

{$POSTER_DOMAIN} {
	# сертификат Let's Encrypt выпускается и продлевается сам; для этого
	# домен должен указывать на этот сервер, а порты 80 и 443 быть открыты
	encode zstd gzip

	# макеты .cdr бывают по сотне мегабайт — лимит выше, чем у самого приложения
	request_body {
		max_size 320MB
	}

	# X-Forwarded-For и X-Forwarded-Proto Caddy ставит сам; по ним приложение
	# считает лимит попыток входа, отмечает устройства и включает HSTS
	reverse_proxy app:8000 {
		# загрузка большого макета по медленному каналу
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}

	header {
		# приложение отдаёт свои заголовки безопасности; здесь только то,
		# что имеет смысл на уровне сервера
		-Server
	}

	log {
		output stderr
		format console
	}
}
